#!/bin/bash
# ========================================================
# Moodle Permissions Manager - Unified Script
# Supports MOODLE_405_STABLE | MOODLE_500_STABLE | MOODLE_501_STABLE | MOODLE_502_STABLE
# ========================================================

# SCRIPT RELEASE INFORMATION
SCRIPT_RELEASE="26.06"
SCRIPT_AUTHOR="Daniele Lolli (UncleDan)"
SCRIPT_LICENSE="GPL-3.0"

# Exit codes
readonly EXIT_OK=0
readonly EXIT_INVALID_ARGS=1
readonly EXIT_NOT_ROOT=2
readonly EXIT_DIR_NOT_FOUND=3
readonly EXIT_UNKNOWN_VERSION=4
readonly EXIT_CHMOD_FAILED=5
readonly EXIT_CHOWN_FAILED=6
readonly EXIT_MKDIR_FAILED=7
readonly EXIT_CACHE_FAILED=8

# --------------------------------------------------------
# DEFAULT CONFIGURATION
# Edit these to match your environment so the script can
# be launched with --fix only (no extra arguments needed).
# --------------------------------------------------------
MOODLE_BRANCH="MOODLE_501_STABLE"   # Full Moodle branch
MOODLE_DIR="/var/www/moodle"         # Moodle installation path
MOODLEDATA_DIR="/var/moodledata"     # moodledata path

# Flags
DRY_RUN=false
APPLY_FIXES=false
CLEAR_CACHE=false

# --------------------------------------------------------
# 1. DYNAMIC WEB USER DETECTION
# --------------------------------------------------------
if id "www-data" >/dev/null 2>&1; then
    WWW_USER="www-data"; WWW_GROUP="www-data"
elif id "apache" >/dev/null 2>&1; then
    WWW_USER="apache"; WWW_GROUP="apache"
elif id "nginx" >/dev/null 2>&1; then
    WWW_USER="nginx"; WWW_GROUP="nginx"
else
    WWW_USER="www-data"; WWW_GROUP="www-data"
fi

# --------------------------------------------------------
# HELPER: run or simulate a command
# --------------------------------------------------------
run_cmd() {
    if [ "$DRY_RUN" = true ]; then
        echo "   [DRY-RUN] $*"
    else
        "$@"
    fi
}

# --------------------------------------------------------
# CORE FUNCTIONS
# --------------------------------------------------------

show_header() {
    echo "================================================================================"
    echo " Moodle Permissions Manager v${SCRIPT_RELEASE}"
    echo "================================================================================"
    echo " Web user   : ${WWW_USER}:${WWW_GROUP}"
    [ -n "$MOODLE_BRANCH"  ] && echo " Branch     : ${MOODLE_BRANCH}"
    echo " Moodle dir : ${MOODLE_DIR}"
    echo " Data dir   : ${MOODLEDATA_DIR}"
    [ "$DRY_RUN"  = true ] && echo " Mode       : DRY-RUN (no changes applied)"
    [ "$DRY_RUN"  = false ] && [ "$APPLY_FIXES" = true ] && echo " Mode       : FIX (real changes)"
    echo "================================================================================"
}

show_help() {
    echo "Usage: $0 -mv BRANCH [OPTIONS]"
    echo ""
    echo "Required branch (-mv):"
    echo "  MOODLE_405_STABLE  (default if not specified)"
    echo "  MOODLE_500_STABLE"
    echo "  MOODLE_501_STABLE"
    echo "  MOODLE_502_STABLE"
    echo ""
    echo "  If MOODLE_BRANCH, MOODLE_DIR and MOODLEDATA_DIR are set"
    echo "  in the script defaults, just run: $0 --fix"
    echo ""
    echo "Options:"
    echo "  -h,  --help               Show this message"
    echo "  -d,  --dry-run            Simulate the operations without applying them"
    echo "  -f,  --fix                Apply the fixes (requires root)"
    echo "  -c,  --clear-cache        Purge the Moodle cache after the fix"
    echo "  -mp, --moodlepath PATH    Moodle path (default: /var/www/moodle)"
    echo "  -md, --moodledata PATH    moodledata path (default: /var/moodledata)"
    echo ""
    echo "Exit codes:"
    echo "  0  Success"
    echo "  1  Invalid arguments / missing version"
    echo "  2  Root required for --fix"
    echo "  3  Directory not found"
    echo "  4  Unrecognized Moodle version"
    echo "  5  chmod error"
    echo "  6  chown error"
    echo "  7  mkdir error"
    echo "  8  Cache purge error"
}

validate_moodle_branch() {
    case "$1" in
        MOODLE_405_STABLE|MOODLE_500_STABLE|MOODLE_501_STABLE|MOODLE_502_STABLE) ;;
        *)
            echo "❌ ERROR: Unrecognized branch: '$1'."
            echo "   Accepted values:"
            echo "     MOODLE_405_STABLE | MOODLE_500_STABLE | MOODLE_501_STABLE | MOODLE_502_STABLE"
            exit $EXIT_UNKNOWN_VERSION
            ;;
    esac
}

# Returns the major version (4 or 5) from the full branch
get_major_version() {
    case "$1" in
        MOODLE_405_STABLE) echo "4" ;;
        MOODLE_500_STABLE|MOODLE_501_STABLE|MOODLE_502_STABLE) echo "5" ;;
        *) echo "" ;;
    esac
}

check_main_directories() {
    if [ ! -d "$MOODLE_DIR" ]; then
        echo "❌ ERROR: Moodle directory not found: $MOODLE_DIR"
        exit $EXIT_DIR_NOT_FOUND
    fi
    if [ ! -d "$MOODLEDATA_DIR" ]; then
        echo "❌ ERROR: moodledata directory not found: $MOODLEDATA_DIR"
        exit $EXIT_DIR_NOT_FOUND
    fi
}

purge_moodle_cache() {
    echo "🧹 Purging Moodle cache..."
    local purge_script="$MOODLE_DIR/admin/cli/purge_caches.php"
    if [ ! -f "$purge_script" ]; then
        echo "⚠️  purge_caches.php script not found. Cache not purged."
        exit $EXIT_CACHE_FAILED
    fi
    if [ "$DRY_RUN" = true ]; then
        echo "   [DRY-RUN] sudo -u $WWW_USER php $purge_script"
    else
        sudo -u "$WWW_USER" php "$purge_script" || {
            echo "❌ ERROR: purge_caches.php failed."
            exit $EXIT_CACHE_FAILED
        }
        echo "✅ Cache purged."
    fi
}

apply_fixes() {
    local major_version
    major_version=$(get_major_version "$MOODLE_BRANCH")

    echo ""
    echo "🛠️  Applying permissions for ${MOODLE_BRANCH} (major: ${major_version}.x)..."
    check_main_directories

    # -- 1. Ownership --
    echo "→ Ownership: ${WWW_USER}:${WWW_GROUP}"
    run_cmd chown -R "${WWW_USER}:${WWW_GROUP}" "$MOODLE_DIR" || {
        echo "❌ ERROR: chown failed on $MOODLE_DIR"
        exit $EXIT_CHOWN_FAILED
    }
    run_cmd chown -R "${WWW_USER}:${WWW_GROUP}" "$MOODLEDATA_DIR" || {
        echo "❌ ERROR: chown failed on $MOODLEDATA_DIR"
        exit $EXIT_CHOWN_FAILED
    }

    # -- 2. Base permissions --
    echo "→ MOODLE_DIR permissions : u=rwX,g=rX,o=rX"
    run_cmd chmod -R u=rwX,g=rX,o=rX "$MOODLE_DIR" || {
        echo "❌ ERROR: chmod failed on $MOODLE_DIR"
        exit $EXIT_CHMOD_FAILED
    }

    echo "→ MOODLEDATA permissions : u=rwX,g=rwX,o="
    run_cmd chmod -R u=rwX,g=rwX,o= "$MOODLEDATA_DIR" || {
        echo "❌ ERROR: chmod failed on $MOODLEDATA_DIR"
        exit $EXIT_CHMOD_FAILED
    }

    # -- 3. config.php hardening --
    if [ -f "$MOODLE_DIR/config.php" ]; then
        echo "→ Hardening config.php → 640"
        run_cmd chmod 640 "$MOODLE_DIR/config.php" || {
            echo "❌ ERROR: chmod 640 on config.php failed"
            exit $EXIT_CHMOD_FAILED
        }
    fi

    # -- 4. .htaccess on moodledata --
    if [ ! -f "$MOODLEDATA_DIR/.htaccess" ]; then
        echo "→ Creating .htaccess in moodledata"
        if [ "$DRY_RUN" = false ]; then
            echo "deny from all" > "$MOODLEDATA_DIR/.htaccess" || {
                echo "❌ ERROR: unable to create .htaccess"
                exit $EXIT_CHMOD_FAILED
            }
            chown "${WWW_USER}:${WWW_GROUP}" "$MOODLEDATA_DIR/.htaccess"
            chmod 660 "$MOODLEDATA_DIR/.htaccess"
        else
            echo "   [DRY-RUN] echo 'deny from all' > $MOODLEDATA_DIR/.htaccess"
        fi
    fi
    # Nginx warning (.htaccess has no effect)
    if echo "$WWW_USER" | grep -q "nginx"; then
        echo "⚠️  WARNING: web user 'nginx' detected. The .htaccess file has no effect"
        echo "   on Nginx. Make sure the moodledata directory is outside the webroot"
        echo "   or protected through a 'location' block in the Nginx configuration."
    fi

    # -- 5. CLI scripts: only the .php files must be made executable --
    if [ -d "$MOODLE_DIR/admin/cli" ]; then
        echo "→ admin/cli executability (only *.php)"
        run_cmd find "$MOODLE_DIR/admin/cli" -name "*.php" -exec chmod +x {} + || {
            echo "❌ ERROR: chmod +x on admin/cli failed"
            exit $EXIT_CHMOD_FAILED
        }
    fi

    # -- 6. Version-specific directories in moodledata --
    # Moodle 4.x
    local dirs_v4=("cache" "temp" "sessions" "lang" "h5p" "filedir" "trashdir")
    # Moodle 5.x (adds lock, tasks, localcache; keeps filedir, lang, trashdir)
    local dirs_v5=("cache" "temp" "sessions" "lang" "h5p" "filedir" "trashdir" "lock" "tasks" "localcache")

    local dirs=()
    if [ "$major_version" = "4" ]; then
        dirs=("${dirs_v4[@]}")
    else
        dirs=("${dirs_v5[@]}")
    fi

    echo "→ Checking/creating moodledata directories (${#dirs[@]} dirs):"
    for dir in "${dirs[@]}"; do
        if [ ! -d "$MOODLEDATA_DIR/$dir" ]; then
            run_cmd mkdir -p "$MOODLEDATA_DIR/$dir" || {
                echo "❌ ERROR: mkdir failed on $MOODLEDATA_DIR/$dir"
                exit $EXIT_MKDIR_FAILED
            }
            run_cmd chown "${WWW_USER}:${WWW_GROUP}" "$MOODLEDATA_DIR/$dir" || {
                echo "❌ ERROR: chown failed on $MOODLEDATA_DIR/$dir"
                exit $EXIT_CHOWN_FAILED
            }
            run_cmd chmod 770 "$MOODLEDATA_DIR/$dir" || {
                echo "❌ ERROR: chmod 770 failed on $MOODLEDATA_DIR/$dir"
                exit $EXIT_CHMOD_FAILED
            }
            echo "   + $dir (created, ${WWW_USER}:${WWW_GROUP} 770)"
        else
            echo "   ✓ $dir"
        fi
    done

    echo ""
    echo "✅ Permissions successfully applied for ${MOODLE_BRANCH}."
}

# --------------------------------------------------------
# ARGUMENT PARSING
# --------------------------------------------------------
if [ $# -eq 0 ]; then
    show_header
    echo "❌ ERROR: No arguments provided."
    echo ""
    show_help
    exit $EXIT_INVALID_ARGS
fi

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_header
            show_help
            exit $EXIT_OK
            ;;
        -d|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -f|--fix)
            APPLY_FIXES=true
            shift
            ;;
        -c|--clear-cache)
            CLEAR_CACHE=true
            shift
            ;;
        -mp|--moodlepath)
            MOODLE_DIR="$2"
            shift 2
            ;;
        -md|--moodledata)
            MOODLEDATA_DIR="$2"
            shift 2
            ;;
        -mv|--moodleversion)
            MOODLE_BRANCH="$2"
            validate_moodle_branch "$MOODLE_BRANCH"
            shift 2
            ;;
        *)
            echo "❌ ERROR: Unknown argument: '$1'"
            echo "   Use -h to display the help."
            exit $EXIT_INVALID_ARGS
            ;;
    esac
done

# --------------------------------------------------------
# FINAL VALIDATION
# --------------------------------------------------------
if [ -z "$MOODLE_BRANCH" ]; then
    show_header
    echo "❌ ERROR: Moodle branch not specified."
    echo "   Set MOODLE_BRANCH in the defaults or use -mv MOODLE_XYZ_STABLE."
    echo ""
    show_help
    exit $EXIT_INVALID_ARGS
fi

# Validate the branch (also covers the case where it is set only in the defaults)
validate_moodle_branch "$MOODLE_BRANCH"

# dry-run and fix cannot be combined
if [ "$DRY_RUN" = true ] && [ "$APPLY_FIXES" = true ]; then
    echo "❌ ERROR: --dry-run and --fix cannot be used together."
    exit $EXIT_INVALID_ARGS
fi

# --------------------------------------------------------
# EXECUTION
# --------------------------------------------------------
show_header

if [ "$APPLY_FIXES" = true ]; then
    if [ "$(id -u)" -ne 0 ]; then
        echo "❌ ERROR: --fix requires root privileges."
        exit $EXIT_NOT_ROOT
    fi
    apply_fixes
    if [ "$CLEAR_CACHE" = true ]; then
        purge_moodle_cache
    fi

elif [ "$DRY_RUN" = true ]; then
    apply_fixes   # run_cmd prints without executing

else
    echo "ℹ️  No action specified."
    echo "   Use --fix to apply the changes or --dry-run to simulate."
fi

exit $EXIT_OK
